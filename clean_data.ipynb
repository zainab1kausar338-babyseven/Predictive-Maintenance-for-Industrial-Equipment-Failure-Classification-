   "source": [
    "print(\"\\n=== 5. REMOVE DUPLICATES ===\")\n",
    "\n",
    "before = len(df)\n",
    "\n",
    "df = df.drop_duplicates()\n",
    "\n",
    "print(f\"Removed {before - len(df)} duplicates\")\n"
