   ],
   "source": [
    "print(\"=== 1. LOAD DATA ===\")\n",
    "df = pd.read_csv(\"predictive_maintenance_dataset.csv\")\n",
    "print(\"Original Shape:\", df.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "5e53d023",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "=== 2. CLEAN COLUMN NAMES ===\n",
      "Columns: ['date', 'device', 'failure', 'metric1', 'metric2', 'metric3', 'metric4', 'metric5', 'metric6', 'metric7', 'metric8', 'metric9']\n"
     ]
    }
   ],
   "source": [
    "print(\"\\n=== 2. CLEAN COLUMN NAMES ===\")\n",
    "df.columns = df.columns.str.strip().str.lower()\n",
    "df.columns = [re.sub(r'[^a-z0-9_]', '_', col) for col in df.columns]\n",
    "print(\"Columns:\", df.columns.tolist())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "6f91a35f",
   "metadata": {},
   "outputs": [
