     "output_type": "stream",
     "text": [
      "\n",
      "=== 3. CLEAN DATES ===\n"
     ]
    }
   ],
   "source": [
    "print(\"\\n=== 3. CLEAN DATES ===\")\n",
    "df['date'] = pd.to_datetime(df['date'], errors='coerce')\n",
    "df = df.sort_values('date').reset_index(drop=True)"
   ]
  },
